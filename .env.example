# ==========================================
# Google Sheets API & Service Account Config
# ==========================================

# Service Account Email from Google Cloud IAM
GOOGLE_SHEETS_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# RSA Private Key in JWK JSON string format (e.g. {"kty":"RSA","n":"...","e":"AQAB",...})
GOOGLE_SHEETS_PRIVATE_KEY={"kty":"RSA","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"...","alg":"RS256"}

# Target Spreadsheet ID (found in Google Sheets URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SUBSCRIBERS_ID=your_spreadsheet_id_here

# Target Sheet name and range (e.g. Sheet1, or Sheet1!A2:G2)
GOOGLE_SHEETS_SUBSCRIBERS_PAGE=Sheet1!A2:G2

# ==========================================
# CORS & Routing Configuration
# ==========================================

# Comma-separated list of allowed origins (production URLs)
ALLOWED_ORIGINS=https://shreyvarshney.is-a.dev,https://shreyvarshney.pages.dev

# Redirect target for GET / requests
REDIRECT_URL=https://shreyvarshney.pages.dev

# Allow localhost (http://localhost:*, http://127.0.0.1:*) - Set to 'true' only for local development
ALLOW_LOCALHOST=false

# ==========================================
# Rate Limiting & Timezone (Optional)
# ==========================================

# Maximum allowed requests per IP within the time window (default: 5)
MAX_REQUESTS_PER_WINDOW=5

# Rate limit window in seconds (default: 600 = 10 minutes)
RATE_LIMIT_WINDOW_SECONDS=600

# Timezone offset in hours from UTC for local timestamp recording (default: 5.5 = IST)
TIMEZONE_OFFSET_HOURS=5.5
